# Postia (postia.me) production .env — Hostinger VPS
#
# Copy this file to `.env` next to docker-compose.yml and fill in values.
# DO NOT commit the real .env. Secrets live in 1Password.
#
# Generate JWT_SECRET and DB_PASSWORD with:
#   openssl rand -base64 48 | tr -d '=+/\n' | head -c 48 ; echo
#
# Once filled in, run from this directory:
#   docker compose up -d

# === Required: secrets (generate via openssl, store in 1Password) ===
JWT_SECRET=
DB_PASSWORD=

# === AI keys (Phase 4) ===
OPENAI_API_KEY=

# === Social provider OAuth credentials (Phase 3) ===
# Each pair is provisioned at the platform's developer portal under
# admin@vixi.agency. Callback URL pattern: https://postia.me/integrations/social/<provider>

# X (Twitter) — Developer Portal, OAuth 2.0 with PKCE, paid Basic tier required
X_API_KEY=
X_API_SECRET=

# LinkedIn — Marketing Developer Platform (covers personal + Page)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Reddit — script/web app
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Meta — single Meta for Developers app covers Instagram + Facebook Page + Threads
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=

# YouTube — Google Cloud project, YouTube Data API v3, OAuth consent verified
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# TikTok — TikTok for Developers, Login Kit + Content Posting API (review required)
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# Pinterest
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# Dribbble
DRIBBBLE_CLIENT_ID=
DRIBBBLE_CLIENT_SECRET=

# Discord (bot + OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN_ID=

# Slack
SLACK_ID=
SLACK_SECRET=
SLACK_SIGNING_SECRET=

# Telegram (BotFather token, no OAuth)
TELEGRAM_TOKEN=

# Mastodon (instance URL + app credentials)
MASTODON_URL=https://mastodon.social
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=

# GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
