# WordPress (blog.postia.me) production .env — Hostinger VPS
#
# Copy this file to `.env` next to docker-compose.yml and fill in values.
# DO NOT commit the real .env. Secrets live in 1Password.
#
# Generate strong passwords with:
#   openssl rand -base64 32 | tr -d '=+/\n' | head -c 32 ; echo
#
# Once filled in, run from this directory:
#   docker compose up -d

# MariaDB credentials (only used by the WP container and the DB itself —
# never exposed to the public internet)
DB_ROOT_PASSWORD=
DB_PASSWORD=
